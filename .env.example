# Supabase project "LinguABC OS" (eu-central-1).
# Optional: these public values are already the defaults in src/lib/supabase/config.ts
NEXT_PUBLIC_SUPABASE_URL=https://qycffcuuavtlojkxrkiz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tNly7XWNt77Ygp010EPBvw_7K3aUEa0

# Server-only. Used solely to resolve "phone → email" at sign-in.
# Copy from Supabase → Project Settings → API keys (secret key).
# Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SECRET_KEY=            # or SUPABASE_SERVICE_ROLE_KEY (set by the Supabase–Vercel integration)

# Optional: public URL of this app (auth email links). On Vercel it is detected automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI drafting (server-only). Set one; OpenRouter wins if both are set.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Fish Audio text-to-speech for listening (server-only).
FISH_AUDIO_API_KEY=
# Optional: comma-separated fish.audio voice ids. Defaults to the six in src/lib/ai/fish.ts.
FISH_AUDIO_VOICES=
# Optional: TTS model (default s2.1-pro; s1 retires on 31 Dec 2026)
FISH_AUDIO_MODEL=
# Optional: sampling temperature 0-1 (default 0.3; lower keeps each voice steadier)
FISH_AUDIO_TEMPERATURE=
# Optional: Fish Audio model for LinguABC library podcasts. Defaults to FISH_AUDIO_MODEL, then s2.1-pro.
FISH_AUDIO_PODCAST_MODEL=

# Voice provider (server-only): fish (default, production) | qwen (pilot worker) | kokoro (not available yet).
# Anything else or unset means fish.
AUDIO_PROVIDER=
# Optional: AUDIO_SEGMENT_CACHE=off speaks without the segment cache (migration 0029).
AUDIO_SEGMENT_CACHE=
# Qwen3-TTS pilot worker (workers/tts, Modal). Only read when AUDIO_PROVIDER=qwen.
QWEN_TTS_URL=
QWEN_TTS_SECRET=               # same value as the worker's LINGUABC_TTS_SECRET; never commit it
# Optional: comma-separated Qwen speaker names (default Ryan,Aiden,Serena,Vivian)
QWEN_TTS_VOICES=

# Audio Studio engines for LinguABC platform admins (0030 audio jobs). See docs/AUDIO-ENGINES.md.
# Comma separated: fish,chatterbox-turbo,chatterbox,qwen. Unset = fish only. Centres' homework is not affected.
AUDIO_ENGINES=
# One voice worker per engine (base URL, https) and its shared secret (32+ characters; never commit it).
CHATTERBOX_TURBO_WORKER_URL=
CHATTERBOX_TURBO_WORKER_SECRET=
CHATTERBOX_WORKER_URL=
CHATTERBOX_WORKER_SECRET=
QWEN_WORKER_URL=
QWEN_WORKER_SECRET=
# Optional: where workers report progress (default: <site URL>/api/audio-jobs/callback)
AUDIO_JOBS_CALLBACK_URL=

# Parent Telegram bot (server only; never NEXT_PUBLIC_). Leave empty to keep the bot off.
TELEGRAM_BOT_TOKEN=               # from BotFather
TELEGRAM_BOT_USERNAME=            # the bot's @name, for t.me links
TELEGRAM_WEBHOOK_SECRET=          # 32+ random characters; given to setWebhook as secret_token
TELEGRAM_DISPATCH_SECRET=         # 32+ random characters; pg_cron sends it to /api/telegram/dispatch
